"use client";

import { useEffect, useState } from "react";
import {
  ArrowLeft,
  Building2,
  Loader2,
  MapPin,
  Ticket,
} from "lucide-react";
import { Button } from "@/components/ui/button";

type Level = "city" | "subcity" | "woreda";

type TicketService = {
  id: number;
  name: string;
};

type TicketWindow = {
  id: number;
  name: string;
  title: string | null;
  services_count: number;
  services: TicketService[];
};

type ApiResponse = {
  success: boolean;
  message: string;
  data: TicketWindow[];
};

const levels: { id: Level; label: string }[] = [
  { id: "city", label: "City" },
  { id: "subcity", label: "Subcity" },
  { id: "woreda", label: "Woreda" },
];

const API_BASE_URL = process.env.NEXT_PUBLIC_API_URL;

export default function TicketPage() {
  const [level, setLevel] = useState<Level | null>(null);
  const [windows, setWindows] = useState<TicketWindow[]>([]);
  const [selectedWindow, setSelectedWindow] =
    useState<TicketWindow | null>(null);
  const [loading, setLoading] = useState(false);
  const [error, setError] = useState<string | null>(null);

  useEffect(() => {
    if (!level) return;

    const controller = new AbortController();

    async function loadWindows() {
      setLoading(true);
      setError(null);
      setWindows([]);

      try {
        if (!API_BASE_URL) {
          throw new Error("MESOB API URL is not configured.");
        }

        const response = await fetch(
          `${API_BASE_URL}/public/ticket/windows?administrative_level=${level}`,
          {
            signal: controller.signal,
            headers: { Accept: "application/json" },
            cache: "no-store",
          }
        );

        const result: ApiResponse = await response.json();

        if (!response.ok || !result.success) {
          throw new Error(
            result.message || "Unable to retrieve ticket windows."
          );
        }

        if (!controller.signal.aborted) {
          setWindows(result.data);
        }
      } catch (cause) {
        if (!controller.signal.aborted) {
          setError(
            cause instanceof Error
              ? cause.message
              : "Unable to load windows."
          );
        }
      } finally {
        if (!controller.signal.aborted) {
          setLoading(false);
        }
      }
    }

    void loadWindows();

    return () => controller.abort();
  }, [level]);

  function selectLevel(value: Level) {
    setSelectedWindow(null);
    setWindows([]);
    setError(null);
    setLevel(value);
  }

  return (
    <main className="min-h-screen bg-slate-50 px-4 py-8">
      <div className="mx-auto max-w-5xl space-y-8">
        <header className="rounded-2xl bg-white p-6 shadow-sm">
          <div className="flex items-center gap-3">
            <Ticket className="h-9 w-9 text-blue-700" />
            <div>
              <h1 className="text-2xl font-bold text-slate-900">
                MESOB Ticket Kiosk
              </h1>
              <p className="text-sm text-slate-600">
                Select your administrative level, window and service.
              </p>
            </div>
          </div>
        </header>

        <section className="space-y-4">
          <h2 className="text-xl font-semibold">
            1. Select Administrative Level
          </h2>

          <div className="grid gap-4 sm:grid-cols-3">
            {levels.map((item) => (
              <button
                key={item.id}
                type="button"
                onClick={() => selectLevel(item.id)}
                aria-pressed={level === item.id}
                className={`rounded-xl border-2 bg-white p-6 text-left shadow-sm transition focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-700 ${
                  level === item.id
                    ? "border-blue-700"
                    : "border-slate-200 hover:border-blue-400"
                }`}
              >
                {item.id === "city" ? (
                  <Building2 className="mb-3 h-8 w-8" />
                ) : (
                  <MapPin className="mb-3 h-8 w-8" />
                )}

                <span className="text-lg font-semibold">
                  {item.label}
                </span>
              </button>
            ))}
          </div>
        </section>

        {level && (
          <section className="space-y-4">
            <h2 className="text-xl font-semibold">
              2. Select Service Window
            </h2>

            {loading && (
              <div role="status" className="flex items-center gap-2">
                <Loader2 className="h-5 w-5 animate-spin" />
                Loading windows...
              </div>
            )}

            {error && (
              <div
                role="alert"
                className="rounded-lg border border-red-200 bg-red-50 p-4 text-red-700"
              >
                {error}
              </div>
            )}

            {!loading && !error && windows.length === 0 && (
              <p className="text-slate-600">
                No service windows available at this level.
              </p>
            )}

            <div className="grid gap-4 md:grid-cols-2">
              {windows.map((window) => (
                <button
                  key={window.id}
                  type="button"
                  onClick={() => setSelectedWindow(window)}
                  aria-pressed={selectedWindow?.id === window.id}
                  className={`rounded-xl border-2 bg-white p-5 text-left shadow-sm ${
                    selectedWindow?.id === window.id
                      ? "border-blue-700"
                      : "border-slate-200 hover:border-blue-400"
                  }`}
                >
                  <h3 className="font-semibold">{window.name}</h3>
                  <p className="mt-1 text-sm text-slate-600">
                    {window.services_count} assigned services
                  </p>
                </button>
              ))}
            </div>
          </section>
        )}

        {selectedWindow && (
          <section className="space-y-4 rounded-xl bg-white p-6 shadow-sm">
            <div className="flex items-center justify-between gap-4">
              <h2 className="text-xl font-semibold">
                3. Select Service
              </h2>

              <Button
                type="button"
                variant="outline"
                onClick={() => setSelectedWindow(null)}
              >
                <ArrowLeft className="mr-2 h-4 w-4" />
                Back
              </Button>
            </div>

            <p className="text-slate-600">{selectedWindow.name}</p>

            <div className="grid gap-3">
              {selectedWindow.services.map((service) => (
                <div
                  key={service.id}
                  className="rounded-lg border p-4"
                >
                  <p className="font-medium">{service.name}</p>
                  <p className="mt-1 text-xs text-slate-500">
                    Ticket generation will be enabled after
                    backend verification.
                  </p>
                </div>
              ))}
            </div>
          </section>
        )}
      </div>
    </main>
  );
}