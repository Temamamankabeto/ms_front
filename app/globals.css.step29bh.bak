@import "../styles/tailwind.css";
@import "../styles/variables.css";
@import "../styles/theme.css";

/* MESOB TICKET KIOSK PRINT */
@media print {
  @page {
    size: 72mm 120mm;
    margin: 0;
  }

  html,
  body {
    width: 72mm !important;
    height: auto !important;
    min-height: 0 !important;
    margin: 0 !important;
    padding: 0 !important;
    overflow: visible !important;
    background: #fff !important;
  }

  body * {
    visibility: hidden !important;
  }

  body:has(#mesob-print-ticket) > * {
    display: contents !important;
  }

  body:has(#mesob-print-ticket) main,
  body:has(#mesob-print-ticket) [data-state="open"] {
    position: static !important;
    transform: none !important;
    min-height: 0 !important;
    max-height: none !important;
    overflow: visible !important;
  }

  #mesob-print-ticket,
  #mesob-print-ticket * {
    visibility: visible !important;
  }

  #mesob-print-ticket {
    position: absolute !important;
    top: 0 !important;
    left: 0 !important;
    width: 72mm !important;
    max-width: 72mm !important;
    margin: 0 !important;
    padding: 2mm !important;
    box-sizing: border-box !important;
    background: #fff !important;
    color: #000 !important;
    font-family: Arial, sans-serif !important;
    font-size: 11px !important;
    border: none !important;
    box-shadow: none !important;
  }

  #mesob-print-ticket .text-5xl {
    font-size: 30px !important;
    line-height: 1.2 !important;
    color: #000 !important;
  }

  #mesob-print-ticket .bg-slate-50 {
    background: #fff !important;
  }

  #mesob-print-ticket .border,
  #mesob-print-ticket .border-t {
    border-color: #000 !important;
  }
}